[alias]
    # ─── Basic Operations ─────────────────────────────────────────────────────
    a  = "!f() { cd \"${GIT_PREFIX:-.}\" && env a \"$@\"; }; f"
    co = checkout
    sw = switch
    st = "!f() { cd \"${GIT_PREFIX:-.}\" && env st \"$@\"; }; f"
    s  = "!f() { cd \"${GIT_PREFIX:-.}\" && env s \"$@\"; }; f"
    br = branch
    m  = merge

    # ─── Commits ──────────────────────────────────────────────────────────────
    ci   = commit --signoff
    c    = "!f() { cd \"${GIT_PREFIX:-.}\" && env c \"$@\"; }; f"
    cm   = "!f() { cd \"${GIT_PREFIX:-.}\" && env cm \"$@\"; }; f"
    ac   = "!f() { cd \"${GIT_PREFIX:-.}\" && env ac \"$@\"; }; f"
    ca   = commit --signoff -am
    fuck = "!f() { cd \"${GIT_PREFIX:-.}\" && env fuck \"$@\"; }; f"

    # ─── Sync & Remote ────────────────────────────────────────────────────────
    l  = "!f() { cd \"${GIT_PREFIX:-.}\" && env l \"$@\"; }; f"
    p  = "!f() { cd \"${GIT_PREFIX:-.}\" && env p \"$@\"; }; f"

    # ─── History & Logs ───────────────────────────────────────────────────────
    lg   = "!f() { cd \"${GIT_PREFIX:-.}\" && env lg \"$@\"; }; f"
    pi   = log -p
    llog = log --graph --name-status --pretty=format:\"%C(red)%h %C(reset)(%cd) %C(green)%an %Creset%s %C(yellow)%d%Creset\" --date=relative

    # ─── Branch Management & Rebase ───────────────────────────────────────────
    re  = rebase -i
    reb = "!r() { git rebase -i HEAD~$1; }; r"
    bye = "!f() { cd \"${GIT_PREFIX:-.}\" && env bye \"$@\"; }; f"

    # ─── Stash & Tags ─────────────────────────────────────────────────────────
    stash   = stash -all
    unstash = stash pop
    tag     = tag -s

    # ─── Inspection & Diff ────────────────────────────────────────────────────
    d  = "!f() { cd \"${GIT_PREFIX:-.}\" && env d \"$@\"; }; f"
    ds = "!f() { cd \"${GIT_PREFIX:-.}\" && env ds \"$@\"; }; f"
    bl = blame -w -C -C -C --color-lines --color-by-age

    # ─── Search & Info ────────────────────────────────────────────────────────
    alias        = config --get-regexp alias
    contributors = shortlog --summary --numbered
    # Find commits by source code
    fc           = "!f() { cd \"${GIT_PREFIX:-.}\" && env fc \"$@\"; }; f"
    # Find commits by commit message
    fm           = "!f() { cd \"${GIT_PREFIX:-.}\" && env fm \"$@\"; }; f"

    # ─── Interactive & Fuzzy ──────────────────────────────────────────────────
    af = "!f() { cd \"${GIT_PREFIX:-.}\" && env af \"$@\"; }; f"
    df = "!f() { cd \"${GIT_PREFIX:-.}\" && env df \"$@\"; }; f"
